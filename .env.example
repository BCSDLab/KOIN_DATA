KOIN_DATA_PROJECT_NAME=koin-data

# Docker images
KOIN_DATA_AIRFLOW_IMAGE=koin-data-airflow:latest
KOIN_DATA_SUPERSET_IMAGE=koin-data-superset:latest

# Postgres metadata database
KOIN_DATA_POSTGRES_USER=koin
KOIN_DATA_POSTGRES_PASSWORD=change_me
KOIN_DATA_AIRFLOW_DB=airflow_metadata
KOIN_DATA_SUPERSET_DB=superset_metadata

# Airflow
KOIN_DATA_AIRFLOW_PORT=8080
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=false
AIRFLOW__WEBSERVER__SECRET_KEY=change_me
# Execution API(JWT) 서명 키. scheduler와 api-server가 같은 값을 써야 task가 실행된다.
# 필수값이며 기본값이 없다. 비어 있으면 Airflow 컨테이너가 뜨지 않는다.
# 생성: openssl rand -base64 32
KOIN_DATA_AIRFLOW_JWT_SECRET=replace-with-generated-secret

# Superset
KOIN_DATA_SUPERSET_DOMAIN=superset.bcsdlab.com
KOIN_DATA_CADDY_EMAIL=admin@example.com
KOIN_DATA_SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=change_me
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_FIRSTNAME=KOIN
SUPERSET_ADMIN_LASTNAME=Admin
SUPERSET_ADMIN_EMAIL=admin@example.com

# BigQuery/dbt
DBT_TARGET=dev
# initial_load_required 태그 모델의 전체 이력 적재·검증 후에만 true로 전환한다.
# false(기본값)이면 daily/monthly 모두 해당 모델과 그 테스트를 실행하지 않는다.
KOIN_DATA_SILVER_BOOTSTRAP_COMPLETE=false
# Stage에서 최초 적재·검증 후에만 true: 기존 silver_events 대신 V2/User만 실행.
# 운영에서는 false 유지. 일별 09시/최근 3일, 월별 보정 주기는 바뀌지 않는다.
KOIN_DATA_SILVER_V2_ONLY=false
# prod 서비스계정 키 경로. 모든 컨테이너가 ./secrets를 /secrets로 마운트하므로
# 이 기본값이 그대로 맞다. 로컬(dev)은 OAuth를 쓰니 주석 유지.
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-service-account.json
KOIN_DATA_GCP_PROJECT=your-gcp-project
KOIN_DATA_BIGQUERY_LOCATION=asia-northeast3
# 입력은 출력과 별도다. 아래는 예시이며 기존 이력과 같은 승인 원천으로 설정한다.
# 운영 원천 읽기→Stage 출력도 원천 계약을 명시하면 가능하다.
KOIN_DATA_GA4_PROJECT=koin-stage-438512
KOIN_DATA_GA4_DATASET=analytics_427218788
# User의 앱 DB 원천도 Stage로 명시한다. 실제 데이터셋/테이블 준비는 별도 확인.
KOIN_DATA_APP_DB_PROJECT=koin-stage-438512
KOIN_DATA_APP_DB_DATASET=analytics_427218788

# V2 전환 시 승인한 원천 4개와 evidence를 담은 JSON을 명시한다.
# 출력 프로젝트와 별개다. 기존 이력이 운영 원천이면 Stage 원천으로 바꾸지 않는다.
KOIN_DATA_SILVER_SOURCE_CONTRACT=
